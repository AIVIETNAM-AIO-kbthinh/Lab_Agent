{% for b in due_soon %}
   - {{ b.han_tra }} — {{ b.ho_ten }} — {{ b.ten_tb }} ({{ b.ma_tb or "?" }}) ×{{ b.so_luong }}{% if b.days_left == 0 %} — hôm nay{% endif %}

{% else %}
   Không có
{% endfor %}

4. THIẾT BỊ QUÁ HẠN TRẢ ({{ overdue|length }})
