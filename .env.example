# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
# Định dạng: KEY=value, không có dấu cách quanh "=", chú thích luôn đặt ở dòng riêng.
# Thứ tự ưu tiên cấu hình: biến môi trường (.env) > config.yaml > mặc định trong code.

# ===== Môi trường =====
# development | staging | production
APP_ENV=development
APP_CONFIG_PATH=config.yaml
# Tự sinh: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# ===== Lab =====
LAB_WEBSITE_URL=http://isilab.click/

# ===== Database =====
# Mật khẩu tự đặt; compose truyền cùng giá trị vào container Postgres.
DATABASE_URL=postgresql+psycopg://labagent:labagent@localhost:5432/labagent
# Phải trùng mật khẩu trong DATABASE_URL (deploy/compose.dev.yaml truyền vào container Postgres)
POSTGRES_PASSWORD=labagent

# ===== Vector DB =====
QDRANT_URL=http://localhost:6333
# Tự sinh: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Compose truyền cùng giá trị vào Qdrant (QDRANT__SERVICE__API_KEY).
QDRANT_API_KEY=

# ===== LLM gateway =====
LLM_API_KEY=
# Claude: endpoint native Anthropic (SDK tự nối /v1/messages)
LLM_ANTHROPIC_BASE_URL=https://api.shopaikey.com
# Gemini chat, embedding, rerank: endpoint OpenAI-compatible
LLM_OPENAI_BASE_URL=https://api.shopaikey.com/v1

# ===== Model theo vai trò (ghi đè config.yaml) =====
LLM_MODEL_MEMBER=claude-haiku-4-5-20251001
LLM_MODEL_GUEST=gemini-3.1-flash-lite
LLM_MODEL_EXTRACT=claude-sonnet-5-5
LLM_MODEL_SCHEMA_GEN=claude-opus-5-5
# Fallback khác hãng: khi kênh Claude lỗi thì dùng model này, và ngược lại
LLM_FALLBACK_CLAUDE=gemini-2.5-flash
LLM_FALLBACK_OPENAI_COMPAT=claude-haiku-4-5-20251001

# ===== Embedding / rerank =====
# Đổi model hoặc số chiều embedding => phải chạy: labagent reindex --all
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3-rerank

# ===== Google OAuth (tài khoản Gmail riêng của lab) =====
GOOGLE_CLIENT_SECRETS_FILE=secrets/credentials.json
GOOGLE_TOKEN_FILE=secrets/token.json

# ===== Quan sát hệ thống (tuỳ chọn) =====
SENTRY_DSN=
LOG_LEVEL=INFO
